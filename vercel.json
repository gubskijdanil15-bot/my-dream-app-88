{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_SUPABASE_URL": "${{ VITE_SUPABASE_URL }}",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "${{ VITE_SUPABASE_PUBLISHABLE_KEY }}"
  }
}
